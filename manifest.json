{
  "manifest_version": 3,
  "name": "Watch List",
  "version": "1.0.0",
  "description": "Take structured, nested notes on videos (YouTube, X.com, Instagram) using a side panel.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Watch List",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
